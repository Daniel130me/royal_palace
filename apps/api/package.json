{
  "name": "@royal-palace/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:drift:check": "tsx scripts/check-schema-drift.ts",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:verify": "tsx scripts/verify-migrations.ts",
    "db:query-plans": "tsx scripts/review-query-plans.ts",
    "db:scheduling-payments:verify": "tsx scripts/verify-scheduling-payments.ts",
    "db:discovery:verify": "tsx scripts/verify-public-discovery.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:validate": "tsx scripts/validate-prisma.ts",
    "dev": "node --watch --env-file-if-exists=../../.env.local --import tsx src/main.ts",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "start": "node --env-file-if-exists=../../.env.local dist/main.js",
    "storage:local:init": "node --env-file-if-exists=../../.env.local --import tsx scripts/init-local-object-storage.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1145.0",
    "@aws-sdk/s3-request-presigner": "3.1145.0",
    "@nestjs/common": "12.0.4",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-fastify": "12.0.4",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@royal-palace/config": "workspace:*",
    "@royal-palace/contracts": "workspace:*",
    "@royal-palace/security": "workspace:*",
    "fastify": "5.12.5",
    "openid-client": "6.8.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "11.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/oidc-provider": "9.12.1",
    "@types/pg": "8.15.5",
    "eslint": "9.39.2",
    "oidc-provider": "9.12.2",
    "pg": "8.16.3",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
