// PostgreSQL-only CHECK constraints, partial indexes, and immutability triggers live
// in the reviewed migration SQL because Prisma cannot express them in its data model.
generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  engineType             = "client"
  previewFeatures        = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

