// PostgreSQL-only CHECK constraints, partial indexes, and immutability triggers live
// in the reviewed migration SQL because Prisma cannot express them in its data model.
generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  engineType             = "client"
  previewFeatures        = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PrincipalStatus {
  ACTIVE
  DISABLED
}

enum ExternalIdentityStatus {
  ACTIVE
  UNLINKED
}

enum AuthSessionStatus {
  ACTIVE
  REVOKED
}

enum OrganizationType {
  HOSPITAL
  PHARMACY
  LABORATORY
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  SUSPENDED
  REVOKED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CatalogueStatus {
  ACTIVE
  INACTIVE
}

enum ConsultationMode {
  VIDEO
  AUDIO
  CHAT
  IN_PERSON
  HOME_VISIT
}

enum RoleScope {
  PLATFORM
  ORGANIZATION
}

enum PlatformRole {
  PATIENT
  MANAGER
  ORGANIZATION_APPLICANT
  ORGANIZATION_STAFF
  PROVIDER
  SUPPORT
  ADMINISTRATOR
  FINANCE
  LOGISTICS
  SYSTEM_WORKER
}

enum AuditResult {
  SUCCEEDED
  DENIED
  FAILED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum InboxStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTERED
}

model IdentityPrincipal {
  id                 String             @id @db.Uuid
  status             PrincipalStatus    @default(ACTIVE)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int                @default(1)
  externalIdentities ExternalIdentity[] @relation("ExternalIdentityOwner")
  linkedIdentities   ExternalIdentity[] @relation("ExternalIdentityLinker")
  sessions           AuthSession[]
  memberships        Membership[]
  roleAssignments    RoleAssignment[]   @relation("RoleAssignee")
  grantedRoles       RoleAssignment[]   @relation("RoleGrantor")
  auditEvents        AuditEvent[]       @relation("AuditActor")
  idempotencyKeys    IdempotencyKey[]
  practitioner       Practitioner?

  @@index([status, createdAt, id], map: "identity_principals_status_created_id_idx")
  @@map("identity_principals")
}

model ExternalIdentity {
  id                  String                 @id @db.Uuid
  principalId         String                 @map("principal_id") @db.Uuid
  issuer              String                 @db.VarChar(255)
  subject             String                 @db.VarChar(255)
  status              ExternalIdentityStatus @default(ACTIVE)
  linkedByPrincipalId String?                @map("linked_by_principal_id") @db.Uuid
  linkedAt            DateTime               @default(now()) @map("linked_at") @db.Timestamptz(6)
  lastAuthenticatedAt DateTime?              @map("last_authenticated_at") @db.Timestamptz(6)
  unlinkedAt          DateTime?              @map("unlinked_at") @db.Timestamptz(6)
  version             Int                    @default(1)
  principal           IdentityPrincipal      @relation("ExternalIdentityOwner", fields: [principalId], references: [id], onDelete: Restrict)
  linkedByPrincipal   IdentityPrincipal?     @relation("ExternalIdentityLinker", fields: [linkedByPrincipalId], references: [id], onDelete: Restrict)
  sessions            AuthSession[]

  @@unique([issuer, subject], map: "external_identities_issuer_subject_key")
  @@index([principalId, status, id], map: "external_identities_principal_status_id_idx")
  @@map("external_identities")
}

model OidcLoginTransaction {
  id                      String       @id @db.Uuid
  issuer                  String       @db.VarChar(255)
  stateHash               String       @unique(map: "oidc_login_transactions_state_hash_key") @map("state_hash") @db.Char(64)
  nonceCiphertext         String       @map("nonce_ciphertext") @db.Text
  pkceVerifierCiphertext  String       @map("pkce_verifier_ciphertext") @db.Text
  encryptionKeyId         String       @map("encryption_key_id") @db.VarChar(64)
  redirectUri             String       @map("redirect_uri") @db.VarChar(2048)
  returnTo                String       @map("return_to") @db.VarChar(2048)
  requestedAssurance      String?      @map("requested_assurance") @db.VarChar(255)
  reauthenticateSessionId String?      @map("reauthenticate_session_id") @db.Uuid
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt               DateTime     @map("expires_at") @db.Timestamptz(6)
  consumedAt              DateTime?    @map("consumed_at") @db.Timestamptz(6)
  reauthenticateSession   AuthSession? @relation(fields: [reauthenticateSessionId], references: [id], onDelete: Restrict)

  @@index([expiresAt, id], map: "oidc_login_transactions_expiry_id_idx")
  @@index([reauthenticateSessionId], map: "oidc_login_transactions_reauth_session_idx")
  @@map("oidc_login_transactions")
}

model AuthSession {
  id                             String                 @id @db.Uuid
  principalId                    String                 @map("principal_id") @db.Uuid
  externalIdentityId             String                 @map("external_identity_id") @db.Uuid
  status                         AuthSessionStatus      @default(ACTIVE)
  csrfSecretHash                 String                 @map("csrf_secret_hash") @db.Char(64)
  providerRefreshTokenCiphertext String?                @map("provider_refresh_token_ciphertext") @db.Text
  providerIdTokenCiphertext      String?                @map("provider_id_token_ciphertext") @db.Text
  encryptionKeyId                String?                @map("encryption_key_id") @db.VarChar(64)
  providerSessionId              String?                @map("provider_session_id") @db.VarChar(255)
  authenticatedAt                DateTime               @map("authenticated_at") @db.Timestamptz(6)
  assuranceContext               String?                @map("assurance_context") @db.VarChar(255)
  authenticationMethods          String[]               @default([]) @map("authentication_methods") @db.VarChar(64)
  createdAt                      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastSeenAt                     DateTime               @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  idleExpiresAt                  DateTime               @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt              DateTime               @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt                      DateTime?              @map("revoked_at") @db.Timestamptz(6)
  revocationReason               String?                @map("revocation_reason") @db.VarChar(100)
  version                        Int                    @default(1)
  principal                      IdentityPrincipal      @relation(fields: [principalId], references: [id], onDelete: Restrict)
  externalIdentity               ExternalIdentity       @relation(fields: [externalIdentityId], references: [id], onDelete: Restrict)
  reauthenticationTransactions   OidcLoginTransaction[]

  @@index([principalId, status, absoluteExpiresAt, id], map: "auth_sessions_principal_status_expiry_id_idx")
  @@index([status, idleExpiresAt, id], map: "auth_sessions_status_idle_expiry_id_idx")
  @@map("auth_sessions")
}

model Organization {
  id                       String                     @id @db.Uuid
  type                     OrganizationType
  status                   OrganizationStatus         @default(ACTIVE)
  verificationStatus       VerificationStatus         @default(PENDING) @map("verification_status")
  verifiedAt               DateTime?                  @map("verified_at") @db.Timestamptz(6)
  legalName                String                     @map("legal_name") @db.VarChar(200)
  displayName              String                     @map("display_name") @db.VarChar(120)
  createdAt                DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                  Int                        @default(1)
  memberships              Membership[]
  auditEvents              AuditEvent[]
  publicProfile            OrganizationPublicProfile?
  facilityLocations        FacilityLocation[]
  organizationServices     OrganizationService[]
  practitionerAffiliations PractitionerAffiliation[]

  @@index([type, status, displayName, id], map: "organizations_type_status_name_id_idx")
  @@index([type, status, verificationStatus, displayName, id], map: "organizations_public_discovery_idx")
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "organizations_display_name_trgm_idx")
  @@map("organizations")
}

model OrganizationPublicProfile {
  organizationId      String            @id @map("organization_id") @db.Uuid
  slug                String            @unique @db.VarChar(120)
  status              PublicationStatus @default(DRAFT)
  summary             String?           @db.VarChar(1000)
  websiteUrl          String?           @map("website_url") @db.VarChar(2048)
  publicPhone         String?           @map("public_phone") @db.VarChar(32)
  acceptingPatients   Boolean           @default(false) @map("accepting_patients")
  emergencyAvailable  Boolean           @default(false) @map("emergency_available")
  openTwentyFourHours Boolean           @default(false) @map("open_twenty_four_hours")
  publishedAt         DateTime?         @map("published_at") @db.Timestamptz(6)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  version             Int               @default(1)
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt(sort: Desc), organizationId], map: "organization_public_profiles_status_published_idx")
  @@index([summary(ops: raw("gin_trgm_ops"))], type: Gin, map: "organization_public_profiles_summary_trgm_idx")
  @@map("organization_public_profiles")
}

model FacilityLocation {
  id                 String            @id @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  status             CatalogueStatus   @default(ACTIVE)
  label              String            @db.VarChar(120)
  addressLine1       String?           @map("address_line_1") @db.VarChar(200)
  addressLine2       String?           @map("address_line_2") @db.VarChar(200)
  locality           String?           @db.VarChar(100)
  administrativeArea String?           @map("administrative_area") @db.VarChar(100)
  postalCode         String?           @map("postal_code") @db.VarChar(32)
  countryCode        String            @map("country_code") @db.Char(2)
  latitude           Decimal?          @db.Decimal(9, 6)
  longitude          Decimal?          @db.Decimal(9, 6)
  publicPhone        String?           @map("public_phone") @db.VarChar(32)
  isPrimary          Boolean           @default(false) @map("is_primary")
  isPublic           Boolean           @default(false) @map("is_public")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int               @default(1)
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  facilityServices   FacilityService[]

  @@unique([organizationId, id], map: "facility_locations_org_id_key")
  @@index([organizationId, isPublic, status, id], map: "facility_locations_org_public_idx")
  @@index([administrativeArea(ops: raw("gin_trgm_ops")), locality(ops: raw("gin_trgm_ops"))], type: Gin, map: "facility_locations_region_trgm_idx")
  @@index([addressLine1(ops: raw("gin_trgm_ops"))], type: Gin, map: "facility_locations_address_trgm_idx")
  @@index([countryCode, postalCode, organizationId, id], map: "facility_locations_country_postal_idx")
  @@map("facility_locations")
}

model ServiceTaxonomy {
  id                   String                @id @db.Uuid
  code                 String                @unique @db.VarChar(80)
  name                 String                @db.VarChar(120)
  category             String                @db.VarChar(100)
  description          String?               @db.VarChar(500)
  status               CatalogueStatus       @default(ACTIVE)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  version              Int                   @default(1)
  organizationServices OrganizationService[]

  @@index([status, category, name, id], map: "service_taxonomies_status_category_name_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "service_taxonomies_name_trgm_idx")
  @@map("service_taxonomies")
}

model OrganizationService {
  id               String            @id @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  serviceId        String            @map("service_id") @db.Uuid
  status           CatalogueStatus   @default(ACTIVE)
  description      String?           @db.VarChar(500)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          Int               @default(1)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service          ServiceTaxonomy   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  facilityServices FacilityService[]

  @@unique([organizationId, serviceId], map: "organization_services_org_service_key")
  @@unique([organizationId, id], map: "organization_services_org_id_key")
  @@index([serviceId, status, organizationId, id], map: "organization_services_service_status_org_idx")
  @@index([organizationId, status, serviceId, id], map: "organization_services_org_status_service_idx")
  @@map("organization_services")
}

model FacilityService {
  id                    String              @id @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  locationId            String              @map("location_id") @db.Uuid
  organizationServiceId String              @map("organization_service_id") @db.Uuid
  status                CatalogueStatus     @default(ACTIVE)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  version               Int                 @default(1)
  location              FacilityLocation    @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Restrict)
  organizationService   OrganizationService @relation(fields: [organizationId, organizationServiceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([locationId, organizationServiceId], map: "facility_services_location_service_key")
  @@index([organizationServiceId, status, locationId, id], map: "facility_services_offering_status_location_idx")
  @@map("facility_services")
}

model ProfessionTaxonomy {
  id                      String                   @id @db.Uuid
  code                    String                   @unique @db.VarChar(80)
  name                    String                   @db.VarChar(160)
  description             String?                  @db.VarChar(1000)
  sourceSystem            String                   @map("source_system") @db.VarChar(255)
  sourceVersion           String?                  @map("source_version") @db.VarChar(80)
  sourceCode              String?                  @map("source_code") @db.VarChar(120)
  sourceUri               String?                  @map("source_uri") @db.VarChar(2048)
  status                  CatalogueStatus          @default(ACTIVE)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                 Int                      @default(1)
  practitionerProfessions PractitionerProfession[]

  @@index([status, name, id], map: "profession_taxonomies_status_name_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "profession_taxonomies_name_trgm_idx")
  @@map("profession_taxonomies")
}

model SpecialtyTaxonomy {
  id                      String                  @id @db.Uuid
  code                    String                  @unique @db.VarChar(100)
  name                    String                  @db.VarChar(180)
  category                String                  @db.VarChar(120)
  description             String?                 @db.VarChar(1000)
  parentId                String?                 @map("parent_id") @db.Uuid
  sourceSystem            String                  @map("source_system") @db.VarChar(255)
  sourceVersion           String?                 @map("source_version") @db.VarChar(80)
  sourceCode              String?                 @map("source_code") @db.VarChar(120)
  sourceUri               String?                 @map("source_uri") @db.VarChar(2048)
  status                  CatalogueStatus         @default(ACTIVE)
  createdAt               DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  version                 Int                     @default(1)
  parent                  SpecialtyTaxonomy?      @relation("SpecialtyHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children                SpecialtyTaxonomy[]     @relation("SpecialtyHierarchy")
  practitionerSpecialties PractitionerSpecialty[]

  @@index([status, category, name, id], map: "specialty_taxonomies_status_category_name_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "specialty_taxonomies_name_trgm_idx")
  @@map("specialty_taxonomies")
}

model Practitioner {
  id                 String                         @id @db.Uuid
  principalId        String?                        @unique @map("principal_id") @db.Uuid
  displayName        String                         @map("display_name") @db.VarChar(160)
  givenName          String                         @map("given_name") @db.VarChar(100)
  familyName         String                         @map("family_name") @db.VarChar(100)
  honorific          String?                        @db.VarChar(40)
  verificationStatus VerificationStatus             @default(PENDING) @map("verification_status")
  verifiedAt         DateTime?                      @map("verified_at") @db.Timestamptz(6)
  createdAt          DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int                            @default(1)
  principal          IdentityPrincipal?             @relation(fields: [principalId], references: [id], onDelete: Restrict)
  publicProfile      PractitionerPublicProfile?
  professions        PractitionerProfession[]
  specialties        PractitionerSpecialty[]
  locations          PractitionerLocation[]
  serviceModes       PractitionerServiceMode[]
  languages          PractitionerLanguage[]
  affiliations       PractitionerAffiliation[]
  publicCredentials  PractitionerPublicCredential[]

  @@index([verificationStatus, displayName, id], map: "practitioners_public_discovery_idx")
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "practitioners_display_name_trgm_idx")
  @@map("practitioners")
}

model PractitionerPublicProfile {
  practitionerId    String            @id @map("practitioner_id") @db.Uuid
  slug              String            @unique @db.VarChar(160)
  status            PublicationStatus @default(DRAFT)
  headline          String?           @db.VarChar(240)
  biography         String?           @db.VarChar(3000)
  photoUrl          String?           @map("photo_url") @db.VarChar(2048)
  yearsExperience   Int?              @map("years_experience")
  acceptingPatients Boolean           @default(false) @map("accepting_patients")
  publishedAt       DateTime?         @map("published_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  version           Int               @default(1)
  practitioner      Practitioner      @relation(fields: [practitionerId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt(sort: Desc), practitionerId], map: "practitioner_public_profiles_status_published_idx")
  @@index([headline(ops: raw("gin_trgm_ops"))], type: Gin, map: "practitioner_public_profiles_headline_trgm_idx")
  @@map("practitioner_public_profiles")
}

model PractitionerProfession {
  id             String             @id @db.Uuid
  practitionerId String             @map("practitioner_id") @db.Uuid
  professionId   String             @map("profession_id") @db.Uuid
  isPrimary      Boolean            @default(false) @map("is_primary")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  practitioner   Practitioner       @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  profession     ProfessionTaxonomy @relation(fields: [professionId], references: [id], onDelete: Restrict)

  @@unique([practitionerId, professionId], map: "practitioner_professions_practitioner_profession_key")
  @@index([professionId, practitionerId, id], map: "practitioner_professions_profession_practitioner_idx")
  @@map("practitioner_professions")
}

model PractitionerSpecialty {
  id             String            @id @db.Uuid
  practitionerId String            @map("practitioner_id") @db.Uuid
  specialtyId    String            @map("specialty_id") @db.Uuid
  isPrimary      Boolean           @default(false) @map("is_primary")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  practitioner   Practitioner      @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  specialty      SpecialtyTaxonomy @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@unique([practitionerId, specialtyId], map: "practitioner_specialties_practitioner_specialty_key")
  @@index([specialtyId, practitionerId, id], map: "practitioner_specialties_specialty_practitioner_idx")
  @@map("practitioner_specialties")
}

model PractitionerLocation {
  id                 String          @id @db.Uuid
  practitionerId     String          @map("practitioner_id") @db.Uuid
  status             CatalogueStatus @default(ACTIVE)
  label              String          @db.VarChar(120)
  addressLine1       String?         @map("address_line_1") @db.VarChar(200)
  addressLine2       String?         @map("address_line_2") @db.VarChar(200)
  locality           String?         @db.VarChar(100)
  administrativeArea String?         @map("administrative_area") @db.VarChar(100)
  postalCode         String?         @map("postal_code") @db.VarChar(32)
  countryCode        String          @map("country_code") @db.Char(2)
  latitude           Decimal?        @db.Decimal(9, 6)
  longitude          Decimal?        @db.Decimal(9, 6)
  isPrimary          Boolean         @default(false) @map("is_primary")
  isPublic           Boolean         @default(false) @map("is_public")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  version            Int             @default(1)
  practitioner       Practitioner    @relation(fields: [practitionerId], references: [id], onDelete: Restrict)

  @@index([practitionerId, isPublic, status, id], map: "practitioner_locations_practitioner_public_idx")
  @@index([countryCode, postalCode, practitionerId, id], map: "practitioner_locations_country_postal_idx")
  @@index([administrativeArea(ops: raw("gin_trgm_ops")), locality(ops: raw("gin_trgm_ops"))], type: Gin, map: "practitioner_locations_region_trgm_idx")
  @@map("practitioner_locations")
}

model PractitionerServiceMode {
  id             String           @id @db.Uuid
  practitionerId String           @map("practitioner_id") @db.Uuid
  mode           ConsultationMode
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  practitioner   Practitioner     @relation(fields: [practitionerId], references: [id], onDelete: Restrict)

  @@unique([practitionerId, mode], map: "practitioner_service_modes_practitioner_mode_key")
  @@index([mode, practitionerId, id], map: "practitioner_service_modes_mode_practitioner_idx")
  @@map("practitioner_service_modes")
}

model PractitionerLanguage {
  id             String       @id @db.Uuid
  practitionerId String       @map("practitioner_id") @db.Uuid
  languageTag    String       @map("language_tag") @db.VarChar(35)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Restrict)

  @@unique([practitionerId, languageTag], map: "practitioner_languages_practitioner_language_key")
  @@index([languageTag, practitionerId, id], map: "practitioner_languages_language_practitioner_idx")
  @@map("practitioner_languages")
}

model PractitionerAffiliation {
  id             String        @id @db.Uuid
  practitionerId String        @map("practitioner_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  facilityName   String        @map("facility_name") @db.VarChar(200)
  roleTitle      String?       @map("role_title") @db.VarChar(160)
  isPublic       Boolean       @default(false) @map("is_public")
  startsAt       DateTime?     @map("starts_at") @db.Date
  endsAt         DateTime?     @map("ends_at") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  version        Int           @default(1)
  practitioner   Practitioner  @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([practitionerId, isPublic, id], map: "practitioner_affiliations_practitioner_public_idx")
  @@index([organizationId, practitionerId, id], map: "practitioner_affiliations_organization_idx")
  @@map("practitioner_affiliations")
}

model PractitionerPublicCredential {
  id               String       @id @db.Uuid
  practitionerId   String       @map("practitioner_id") @db.Uuid
  title            String       @db.VarChar(180)
  issuerName       String       @map("issuer_name") @db.VarChar(200)
  jurisdictionCode String?      @map("jurisdiction_code") @db.VarChar(16)
  awardedYear      Int?         @map("awarded_year")
  isPublic         Boolean      @default(false) @map("is_public")
  verifiedAt       DateTime?    @map("verified_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  version          Int          @default(1)
  practitioner     Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Restrict)

  @@index([practitionerId, isPublic, verifiedAt, id], map: "practitioner_credentials_public_idx")
  @@map("practitioner_public_credentials")
}

model Membership {
  id              String            @id @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  principalId     String            @map("principal_id") @db.Uuid
  effectiveFrom   DateTime          @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveUntil  DateTime?         @map("effective_until") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int               @default(1)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  principal       IdentityPrincipal @relation(fields: [principalId], references: [id], onDelete: Restrict)
  roleAssignments RoleAssignment[]

  @@index([organizationId, effectiveFrom, id], map: "memberships_org_effective_id_idx")
  @@index([principalId, effectiveFrom, id], map: "memberships_principal_effective_id_idx")
  @@map("memberships")
}

model RoleAssignment {
  id                   String             @id @db.Uuid
  principalId          String?            @map("principal_id") @db.Uuid
  membershipId         String?            @map("membership_id") @db.Uuid
  grantedByPrincipalId String?            @map("granted_by_principal_id") @db.Uuid
  role                 PlatformRole
  scope                RoleScope
  effectiveFrom        DateTime           @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveUntil       DateTime?          @map("effective_until") @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  version              Int                @default(1)
  principal            IdentityPrincipal? @relation("RoleAssignee", fields: [principalId], references: [id], onDelete: Restrict)
  membership           Membership?        @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  grantedByPrincipal   IdentityPrincipal? @relation("RoleGrantor", fields: [grantedByPrincipalId], references: [id], onDelete: Restrict)

  @@index([principalId, scope, effectiveFrom, id], map: "role_assignments_principal_scope_effective_id_idx")
  @@index([membershipId, role, effectiveFrom, id], map: "role_assignments_membership_role_effective_id_idx")
  @@map("role_assignments")
}

model AuditEvent {
  id               String             @id @db.Uuid
  occurredAt       DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorPrincipalId String?            @map("actor_principal_id") @db.Uuid
  effectiveRole    PlatformRole?      @map("effective_role")
  action           String             @db.VarChar(160)
  resourceType     String             @map("resource_type") @db.VarChar(100)
  resourceId       String             @map("resource_id") @db.Uuid
  organizationId   String?            @map("organization_id") @db.Uuid
  patientScopeId   String?            @map("patient_scope_id") @db.Uuid
  result           AuditResult
  reasonCode       String?            @map("reason_code") @db.VarChar(100)
  requestId        String             @map("request_id") @db.VarChar(128)
  correlationId    String?            @map("correlation_id") @db.VarChar(128)
  metadata         Json               @default("{}") @db.JsonB
  actorPrincipal   IdentityPrincipal? @relation("AuditActor", fields: [actorPrincipalId], references: [id], onDelete: Restrict)
  organization     Organization?      @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt(sort: Desc), id(sort: Desc)], map: "audit_events_org_occurred_id_idx")
  @@index([actorPrincipalId, occurredAt(sort: Desc), id(sort: Desc)], map: "audit_events_actor_occurred_id_idx")
  @@index([resourceType, resourceId, occurredAt(sort: Desc)], map: "audit_events_resource_occurred_idx")
  @@map("audit_events")
}

model IdempotencyKey {
  id                 String            @id @db.Uuid
  principalId        String            @map("principal_id") @db.Uuid
  operation          String            @db.VarChar(128)
  key                String            @db.VarChar(128)
  requestHash        String            @map("request_hash") @db.Char(64)
  status             IdempotencyStatus @default(IN_PROGRESS)
  responseStatusCode Int?              @map("response_status_code")
  resourceType       String?           @map("resource_type") @db.VarChar(100)
  resourceId         String?           @map("resource_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz(6)
  principal          IdentityPrincipal @relation(fields: [principalId], references: [id], onDelete: Restrict)

  @@unique([principalId, operation, key], map: "idempotency_keys_principal_operation_key_key")
  @@index([expiresAt], map: "idempotency_keys_expires_at_idx")
  @@map("idempotency_keys")
}

model OutboxEvent {
  id            String    @id @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(100)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(160)
  eventVersion  Int       @default(1) @map("event_version")
  payload       Json      @db.JsonB
  traceId       String?   @map("trace_id") @db.VarChar(64)
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attemptCount  Int       @default(0) @map("attempt_count")
  lastErrorCode String?   @map("last_error_code") @db.VarChar(100)

  @@index([aggregateType, aggregateId, occurredAt, id], map: "outbox_events_aggregate_occurred_id_idx")
  @@map("outbox_events")
}

model InboxEvent {
  id            String      @id @db.Uuid
  consumer      String      @db.VarChar(128)
  messageId     String      @map("message_id") @db.VarChar(255)
  eventType     String      @map("event_type") @db.VarChar(160)
  payloadHash   String      @map("payload_hash") @db.Char(64)
  status        InboxStatus @default(RECEIVED)
  receivedAt    DateTime    @default(now()) @map("received_at") @db.Timestamptz(6)
  processingAt  DateTime?   @map("processing_at") @db.Timestamptz(6)
  processedAt   DateTime?   @map("processed_at") @db.Timestamptz(6)
  attemptCount  Int         @default(0) @map("attempt_count")
  lastErrorCode String?     @map("last_error_code") @db.VarChar(100)

  @@unique([consumer, messageId], map: "inbox_events_consumer_message_key")
  @@index([status, receivedAt, id], map: "inbox_events_status_received_id_idx")
  @@map("inbox_events")
}
