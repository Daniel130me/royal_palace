# Copy this file to .env.local and supply development-only values. Never reuse these values outside local development.

# Runtime identity and logging.
APP_ENV=
APP_VERSION=
LOG_LEVEL=

# Service ports. Leave PORT unset when starting both API and worker together; each service has its own documented default.
PORT=
API_BASE_URL=

# PostgreSQL connection and local container initialization.
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# Redis-backed local queue and coordination.
REDIS_URL=
REDIS_PORT=
QUEUE_NAMESPACE=

# S3-compatible object storage. Values must be development-only credentials.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET_QUARANTINE=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=
MINIO_CONSOLE_PORT=

# Local malware scanner.
CLAMAV_HOST=
CLAMAV_PORT=

# Bounded dependency readiness timeout in milliseconds.
DEPENDENCY_TIMEOUT_MS=

# Production-only and intentionally has no default. Do not set until the region approval gate is resolved.
AWS_REGION=
