# Copy this file to .env.local and supply development-only values. Never reuse these values outside local development.

# Runtime identity and logging.
APP_ENV=
APP_VERSION=
LOG_LEVEL=

# Service ports. Leave PORT unset when starting both API and worker together; each service has its own documented default.
PORT=
API_BASE_URL=
WEB_ORIGIN=

# Vendor-neutral OpenID Connect. Synthetic/local values only until Increment 04B
# approves the production provider and tenant. Generate each key independently as
# 32 random bytes encoded with base64; never reuse values across environments.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_AUTH_METHOD=client_secret_basic
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
OIDC_ASSURANCE_CONTEXT_MAP=
PRIVILEGED_ASSURANCE_CONTEXT=urn:royal-palace:aal2
PRIVILEGED_AUTH_MAX_AGE_SECONDS=900
REFERRAL_ACTIVE_SIGNING_KEY_ID=
REFERRAL_SIGNING_KEYS=
IDENTITY_ACTIVE_ENCRYPTION_KEY_ID=
IDENTITY_ENCRYPTION_KEYS=
BFF_ACTIVE_COOKIE_KEY_ID=
BFF_COOKIE_ENCRYPTION_KEYS=
BFF_INTERNAL_SECRET=
BFF_API_TIMEOUT_MS=5000
LOGIN_TRANSACTION_TTL_SECONDS=300
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800

# Payment gateway is deliberately disabled by default. `synthetic` is permitted only
# for local development/test; staging and production fail startup unless this remains
# disabled until a live provider decision and adapter review are approved.
PAYMENT_GATEWAY_MODE=disabled
PAYMENT_CHECKOUT_BASE_URL=
PAYMENT_CHECKOUT_TTL_SECONDS=900
PAYMENT_WEBHOOK_ACTIVE_KEY_ID=
PAYMENT_WEBHOOK_SIGNING_KEYS=
PAYMENT_RESERVATION_TTL_SECONDS=900

# Notification delivery remains disabled in protected environments until providers,
# sending regions, verified recipient resolution, consent, and content policy are approved.
# `synthetic` records deterministic provider acknowledgements without contacting users.
NOTIFICATION_DELIVERY_MODE=disabled

# PostgreSQL connection and local container initialization.
DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# Destructive, synthetic-only seed and migration verification are separately gated.
ALLOW_SYNTHETIC_SEED=false
DATABASE_MIGRATION_VERIFY=false

# Redis-backed local queue and coordination.
REDIS_URL=
REDIS_PORT=
QUEUE_NAMESPACE=

# S3-compatible object storage. Values must be development-only credentials.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET_QUARANTINE=
OBJECT_STORAGE_BUCKET_CLEAN=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_UPLOAD_TTL_SECONDS=300
OBJECT_STORAGE_DOWNLOAD_TTL_SECONDS=60
OBJECT_STORAGE_API_PORT=
OBJECT_STORAGE_CONSOLE_PORT=

# Local malware scanner.
CLAMAV_HOST=
CLAMAV_PORT=

# Bounded dependency readiness timeout in milliseconds.
DEPENDENCY_TIMEOUT_MS=

# Production-only and intentionally has no default. Do not set until the region approval gate is resolved.
AWS_REGION=
