// Royal Palace Health Care Digital Platform — Prisma schema
// SQLite-backed prototype database. Statuses are stored as String
// (SQLite has no native enum) and validated in the application layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// CORE ACCOUNT / AUTH
// ---------------------------------------------------------------------------

model User {
  id           String   @id
  email        String   @unique
  phone        String?
  password     String
  role         String // patient | doctor | dentist | pharmacy | laboratory | logistics | admin
  status       String   @default("active") // active | pending | suspended
  profileId    String? // FK to the role-specific profile
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// PATIENTS & DEPENDANTS
// ---------------------------------------------------------------------------

model Patient {
  id              String   @id
  userId          String // not unique: dependants share the parent's account
  parentPatientId String? // null for primary patient, set for dependants
  patientNumber   String   @unique
  firstName       String
  lastName        String
  dateOfBirth     String
  gender          String
  phone           String
  email           String
  city            String
  state           String
  country         String   @default("Nigeria")
  bloodGroup      String?
  genotype        String?
  height          Float?
  weight          Float?
  // JSON arrays: allergies, conditions, medications (HealthRecordItem[])
  allergies       String   @default("[]")
  conditions      String   @default("[]")
  medications     String   @default("[]")
  emergencyName   String?
  emergencyPhone  String?
  emergencyRel    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments         Appointment[]
  encounters          ClinicalEncounter[]
  prescriptions       Prescription[]
  labRequests         LaboratoryRequest[]
  labBookings         LaboratoryBooking[]
  labResults          LaboratoryResult[]
  pharmacyOrders      PharmacyOrder[]
  recordAccessGrants  RecordAccessGrant[]
  consents            Consent[]
  referrals           Referral[]            @relation("ReferralPatient")
  carePlans           CarePlan[]
  payments            Payment[]
  ratings             Rating[]
  uploadedPrescriptions UploadedPrescription[]
}

// ---------------------------------------------------------------------------
// PROVIDERS (Doctors / Dentists)
// ---------------------------------------------------------------------------

model Provider {
  id                 String   @id
  userId             String   @unique
  providerNumber     String   @unique
  firstName          String
  lastName           String
  title              String // e.g. Dr., Dr. (Mrs.)
  specialty          String
  professionalTitle  String
  qualifications     String   @default("[]") // JSON string[]
  yearsExperience    Int
  biography          String
  languages         String   @default("[]") // JSON string[]
  registrationNumber String
  licenceNumber      String
  licenceExpiry      String
  verificationStatus String   @default("submitted")
  consultationModes  String   @default("[]") // JSON string[]
  city               String
  state              String
  rating             Float    @default(0)
  reviewCount        Int      @default(0)
  profileImage       String?
  consultationFee    Int      @default(15000) // cached from active service price
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  appointments       Appointment[]
  encounters         ClinicalEncounter[]
  prescriptions      Prescription[]
  labRequests        LaboratoryRequest[]
  referralsSent      Referral[]            @relation("ReferralSender")
  referralsReceived  Referral[]            @relation("ReferralRecipientProvider")
  applications       ProviderApplication[]
}

model ProviderApplication {
  id              String   @id
  providerId      String
  status          String   @default("submitted")
  submittedAt     DateTime @default(now())
  reviewedAt      DateTime?
  reviewerId      String? // admin user id
  reviewerNotes   String?
  documents       String   @default("[]") // JSON file metadata
  history         String   @default("[]") // JSON verification history
  provider        Provider @relation(fields: [providerId], references: [id])
}

// ---------------------------------------------------------------------------
// PHARMACIES
// ---------------------------------------------------------------------------

model Pharmacy {
  id              String   @id
  userId          String   @unique
  pharmacyNumber  String   @unique
  name            String
  city            String
  state           String
  address         String
  phone           String
  email           String
  verificationStatus String @default("approved")
  commissionPct   Float    @default(8)
  rating          Float    @default(0)

  // Manager attribution (plan §4): "acquired by" is permanent, "currently
  // managed by" changes with reassignment and is cached here for fast filters.
  acquiredByManagerId       String?
  acquiredAt                DateTime?
  currentManagerId          String?
  managerAssignedAt         DateTime?
  managerRelationshipStatus String? // active | paused | ended (null = never managed)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products        PharmacyProduct[]
  orders          PharmacyOrder[]
  prescriptions   Prescription[]
  payments        OrganizationPayment[]
  assignments     ManagerAssignment[]

  acquiredByManager Manager? @relation("PharmacyAcquiredBy", fields: [acquiredByManagerId], references: [id])
  currentManager    Manager? @relation("PharmacyCurrentManager", fields: [currentManagerId], references: [id])

  @@index([currentManagerId, managerRelationshipStatus])
  @@index([acquiredByManagerId])
  @@index([currentManagerId])
}

model PharmacyProduct {
  id                  String   @id
  pharmacyId         String
  name                String
  genericName         String
  brand               String?
  category            String
  strength            String
  dosageForm          String
  manufacturer        String?
  price               Int
  stockQuantity       Int
  batch               String?
  expiryDate          String
  prescriptionRequired Boolean @default(true)
  // controlled meds (e.g. opioids, psychotropics) CANNOT be ordered directly
  // by a patient — they require a doctor's prescription first.
  controlled          Boolean  @default(false)
  storageRequirements String?
  status              String   @default("active")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  pharmacy            Pharmacy @relation(fields: [pharmacyId], references: [id])
}

// ---------------------------------------------------------------------------
// LABORATORIES
// ---------------------------------------------------------------------------

model Laboratory {
  id                String   @id
  userId            String   @unique
  laboratoryNumber  String   @unique
  name              String
  city              String
  state             String
  address           String
  phone             String
  email             String
  verificationStatus String @default("approved")
  rating            Float    @default(0)

  // Manager attribution — same semantics as Pharmacy.
  acquiredByManagerId       String?
  acquiredAt                DateTime?
  currentManagerId          String?
  managerAssignedAt         DateTime?
  managerRelationshipStatus String? // active | paused | ended (null = never managed)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bookings          LaboratoryBooking[]
  results           LaboratoryResult[]
  payments          OrganizationPayment[]
  assignments       ManagerAssignment[]

  acquiredByManager Manager? @relation("LaboratoryAcquiredBy", fields: [acquiredByManagerId], references: [id])
  currentManager    Manager? @relation("LaboratoryCurrentManager", fields: [currentManagerId], references: [id])

  @@index([currentManagerId, managerRelationshipStatus])
  @@index([acquiredByManagerId])
  @@index([currentManagerId])
}

// ---------------------------------------------------------------------------
// LOGISTICS
// ---------------------------------------------------------------------------

model LogisticsProvider {
  id                  String   @id
  userId             String   @unique
  logisticsNumber    String   @unique
  name               String
  vehicleType        String
  city               String
  state              String
  phone              String
  email              String
  verificationStatus String   @default("approved")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  deliveries         Delivery[]
}

// ---------------------------------------------------------------------------
// SERVICES & PRICING (platform-controlled)
// ---------------------------------------------------------------------------

model Service {
  id          String   @id
  category    String // consultation | dental | laboratory | home | preventive | chronic | logistics | subscription
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  prices      ServicePrice[]
}

model ServicePrice {
  id            String   @id
  serviceId     String
  patientPrice  Int
  providerPayout Int
  platformMargin Int
  currency      String   @default("NGN")
  effectiveFrom String
  status        String   @default("active") // active | scheduled | inactive
  createdAt     DateTime @default(now())

  service       Service  @relation(fields: [serviceId], references: [id])
}

// ---------------------------------------------------------------------------
// APPOINTMENTS
// ---------------------------------------------------------------------------

model Appointment {
  id                 String   @id
  patientId          String
  providerId         String
  serviceId          String?
  servicePriceId     String?
  date               String
  time               String
  durationMinutes    Int      @default(30)
  consultationChannel String  @default("video") // video | audio | chat
  price              Int
  paymentStatus      String   @default("pending") // pending | paid | refunded
  status             String   @default("scheduled")
  intakeForm         String   @default("{}") // JSON
  consentStatus      String   @default("granted")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  patient            Patient  @relation(fields: [patientId], references: [id])
  provider           Provider @relation(fields: [providerId], references: [id])
  encounter          ClinicalEncounter?
  payment            Payment?
}

// ---------------------------------------------------------------------------
// CLINICAL ENCOUNTERS
// ---------------------------------------------------------------------------

model ClinicalEncounter {
  id                 String   @id
  encounterNumber    String   @unique
  appointmentId      String   @unique
  patientId         String
  providerId         String
  status             String   @default("open") // open | completed | amended
  locked             Boolean  @default(false)
  // SOAP / structured documentation stored as JSON
  documentation      String   @default("{}")
  signedAt           DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  appointment        Appointment @relation(fields: [appointmentId], references: [id])
  patient           Patient     @relation(fields: [patientId], references: [id])
  provider          Provider    @relation(fields: [providerId], references: [id])
  prescriptions     Prescription[]
  labRequests       LaboratoryRequest[]
  referrals         Referral[]
  diagnoses         Diagnosis[]
}

model Diagnosis {
  id           String   @id
  encounterId  String
  patientId    String
  code         String?
  description  String
  type         String   @default("primary") // primary | secondary | differential | provisional
  status       String   @default("active")
  createdAt    DateTime @default(now())

  encounter    ClinicalEncounter @relation(fields: [encounterId], references: [id])
}

// ---------------------------------------------------------------------------
// PRESCRIPTIONS
// ---------------------------------------------------------------------------

model Prescription {
  id               String   @id
  prescriptionNumber String @unique
  encounterId      String?
  patientId        String
  providerId       String
  status           String   @default("issued") // issued | awaiting_pharmacy | partially_fulfilled | fulfilled | expired | cancelled
  validityStartDate String
  expiryDate       String
  notes            String?
  // free-text clinical note from the prescribing doctor (dosage rationale,
  // warnings, follow-up advice). Shown on the prescription detail.
  doctorNote        String?
  // denormalised snapshot of the issuing pharmacy for prescriptions that are
  // sent to a specific pharmacy (filled in when the Rx is created or sent).
  pharmacyId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  encounter        ClinicalEncounter? @relation(fields: [encounterId], references: [id])
  patient          Patient  @relation(fields: [patientId], references: [id])
  provider         Provider @relation(fields: [providerId], references: [id])
  pharmacy         Pharmacy? @relation(fields: [pharmacyId], references: [id])
  items            PrescriptionItem[]
  pharmacyOrders   PharmacyOrder[]
}

model PrescriptionItem {
  id                String   @id
  prescriptionId    String
  medicine          String
  genericName       String?
  strength          String
  dosageForm        String
  dose              String
  route             String
  frequency         String
  duration          String
  quantity          Int
  refillAllowance   Int      @default(0)
  substitutionAllowed Boolean @default(true)
  instructions       String?
  createdAt          DateTime @default(now())

  prescription      Prescription @relation(fields: [prescriptionId], references: [id])
}

// ---------------------------------------------------------------------------
// LABORATORY
// ---------------------------------------------------------------------------

model LaboratoryRequest {
  id               String   @id
  requestNumber    String   @unique
  encounterId      String?
  patientId        String
  requestingProviderId String
  tests            String   @default("[]") // JSON string[]
  clinicalIndication String?
  priority         String   @default("routine") // routine | urgent | stat
  preparationInstructions String?
  fastingRequired  Boolean  @default(false)
  sampleType       String?
  notes            String?
  status           String   @default("pending_booking")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  encounter        ClinicalEncounter? @relation(fields: [encounterId], references: [id])
  patient          Patient  @relation(fields: [patientId], references: [id])
  provider         Provider @relation(fields: [requestingProviderId], references: [id])
  booking          LaboratoryBooking?
  result           LaboratoryResult?
}

model LaboratoryBooking {
  id               String   @id
  bookingNumber    String   @unique
  requestId        String   @unique
  patientId        String
  laboratoryId     String
  collectionMode   String   @default("facility") // facility | home
  homeAddress      String?
  date             String
  time             String
  price            Int
  paymentStatus    String   @default("paid")
  status           String   @default("booking_accepted")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  request          LaboratoryRequest @relation(fields: [requestId], references: [id])
  patient          Patient   @relation(fields: [patientId], references: [id])
  laboratory       Laboratory @relation(fields: [laboratoryId], references: [id])
}

model LaboratoryResult {
  id               String   @id
  resultNumber     String   @unique
  requestId        String   @unique
  bookingId        String?
  patientId        String
  laboratoryId     String
  test             String
  sampleCollectionDate String
  resultDate       String
  value            String
  unit             String?
  referenceRange   String?
  abnormalIndicator String? // normal | high | low | critical
  interpretation   String?
  attachment       String? // JSON file metadata
  reviewer         String?
  status           String   @default("published")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  request          LaboratoryRequest @relation(fields: [requestId], references: [id])
  patient          Patient   @relation(fields: [patientId], references: [id])
  laboratory       Laboratory @relation(fields: [laboratoryId], references: [id])
}

// ---------------------------------------------------------------------------
// PHARMACY ORDERS
// ---------------------------------------------------------------------------

model PharmacyOrder {
  id               String   @id
  orderNumber      String   @unique
  prescriptionId   String?
  patientId        String
  pharmacyId       String
  deliveryAddress  String?
  deliveryFee      Int      @default(0)
  subtotal         Int      @default(0)
  commissionTotal Int      @default(0)
  total            Int      @default(0)
  paymentStatus    String   @default("paid")
  status           String   @default("paid")
  verificationCode String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  prescription     Prescription? @relation(fields: [prescriptionId], references: [id])
  patient          Patient  @relation(fields: [patientId], references: [id])
  pharmacy         Pharmacy @relation(fields: [pharmacyId], references: [id])
  items            PharmacyOrderItem[]
  delivery         Delivery?
}

model PharmacyOrderItem {
  id               String   @id
  orderId          String
  productId        String
  productName      String
  quantity         Int
  unitPrice        Int
  gross            Int
  commissionPct    Float
  commissionAmount Int
  pharmacyNet      Int
  createdAt        DateTime @default(now())

  order            PharmacyOrder @relation(fields: [orderId], references: [id])
}

// ---------------------------------------------------------------------------
// DELIVERIES (LOGISTICS)
// ---------------------------------------------------------------------------

model Delivery {
  id               String   @id
  deliveryNumber   String   @unique
  orderId          String   @unique
  logisticsProviderId String
  packageType      String   @default("pharmacy")
  pickupLocation   String
  pickupContact    String
  deliveryLocation String
  recipientName    String
  handlingInstruction String?
  verificationCode String
  payout           Int
  status           String   @default("assigned")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  order            PharmacyOrder @relation(fields: [orderId], references: [id])
  logisticsProvider LogisticsProvider @relation(fields: [logisticsProviderId], references: [id])
}

// ---------------------------------------------------------------------------
// REFERRALS & CARE HANDOFFS
// ---------------------------------------------------------------------------

model Referral {
  id               String   @id
  referralNumber   String   @unique
  encounterId      String?
  patientId        String
  senderProviderId String
  recipientProviderId String?
  recipientSpecialty String?
  reason           String
  symptoms         String?
  relevantHistory  String?
  diagnosis        String?
  currentTreatment String?
  requiredAction   String?
  urgency          String   @default("routine") // routine | urgent | emergency
  attachments      String   @default("[]") // JSON file metadata
  accessExpiry     String?
  status           String   @default("sent")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  encounter        ClinicalEncounter? @relation(fields: [encounterId], references: [id])
  patient          Patient  @relation("ReferralPatient", fields: [patientId], references: [id])
  sender           Provider @relation("ReferralSender", fields: [senderProviderId], references: [id])
  recipient        Provider? @relation("ReferralRecipientProvider", fields: [recipientProviderId], references: [id])
}

// ---------------------------------------------------------------------------
// CONSENT & RECORD ACCESS
// ---------------------------------------------------------------------------

model RecordAccessGrant {
  id               String   @id
  patientId        String
  granteeType      String // provider | pharmacy | laboratory | admin
  granteeId        String?
  granteeName      String
  organisation     String?
  reason           String
  informationShared String  @default("[]") // JSON string[]
  grantedAt        DateTime @default(now())
  expiresAt        String?
  relatedEncounterId String?
  relatedReferralId String?
  status           String   @default("active") // active | revoked | expired

  patient          Patient  @relation(fields: [patientId], references: [id])
}

model Consent {
  id               String   @id
  patientId        String
  type             String // consultation | laboratory | pharmacy | research
  status           String   @default("granted")
  grantedAt        DateTime @default(now())
  details          String?

  patient          Patient  @relation(fields: [patientId], references: [id])
}

// ---------------------------------------------------------------------------
// PAYMENTS, COMMISSIONS, SETTLEMENTS, REFUNDS
// ---------------------------------------------------------------------------

model Payment {
  id               String   @id
  paymentNumber    String   @unique
  appointmentId    String?  @unique
  patientId        String
  amount           Int
  method           String   @default("card") // card | bank_transfer
  status           String   @default("successful")
  reference        String?
  createdAt        DateTime @default(now())

  appointment      Appointment? @relation(fields: [appointmentId], references: [id])
  patient          Patient  @relation(fields: [patientId], references: [id])
}

model Settlement {
  id               String   @id
  settlementNumber String   @unique
  entityType       String // provider | pharmacy | laboratory | logistics
  entityId         String
  entityName       String
  periodStart      String
  periodEnd        String
  grossAmount      Int
  commissionAmount Int
  netAmount        Int
  status           String   @default("pending") // pending | paid
  createdAt        DateTime @default(now())
}

// ---------------------------------------------------------------------------
// CARE PLANS
// ---------------------------------------------------------------------------

model CarePlan {
  id               String   @id
  patientId        String
  title            String
  description      String?
  startDate        String
  endDate          String?
  status           String   @default("active")
  goals            String   @default("[]") // JSON
  createdAt        DateTime @default(now())

  patient          Patient  @relation(fields: [patientId], references: [id])
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS, MESSAGES, RATINGS, COMPLAINTS, AUDIT LOGS
// ---------------------------------------------------------------------------

model Notification {
  id               String   @id
  recipientId      String // generic profile/user id — NOT a FK (multi-role)
  recipientType    String // patient | provider | pharmacy | laboratory | logistics | admin
  title            String
  body             String
  type             String // appointment | prescription | laboratory | pharmacy | logistics | system
  relatedId        String?
  read             Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model Rating {
  id               String   @id
  patientId        String
  entityType       String // provider | pharmacy | laboratory
  entityId         String
  score            Int // 1-5
  comment          String?
  createdAt        DateTime @default(now())

  patient          Patient  @relation(fields: [patientId], references: [id])
}

model Complaint {
  id               String   @id
  complainantId     String
  complainantType   String
  subject          String
  description      String
  status           String   @default("open") // open | investigating | resolved | closed
  priority         String   @default("normal")
  createdAt        DateTime @default(now())
}

model AuditLog {
  id               String   @id
  actorId          String // generic profile/user id — NOT a FK (multi-role)
  actorRole        String
  action           String
  entityType       String
  entityId         String // generic — NOT a FK
  description      String
  timestamp        DateTime @default(now())
}

// ---------------------------------------------------------------------------
// PAYOUT REQUESTS
// Providers, pharmacies, laboratories and logistics can request a payout of
// their accrued earnings. Admin reviews and marks the payout as paid.
// ---------------------------------------------------------------------------

model PayoutRequest {
  id               String   @id
  payoutNumber     String   @unique
  entityType       String // provider | pharmacy | laboratory | logistics | manager
  // entityId is a plain application-level reference (NOT a FK): one column
  // points at different tables depending on entityType, which SQLite cannot
  // express as physical foreign keys. Referential integrity is enforced in
  // the action endpoints.
  entityId         String
  entityName       String
  amountRequested  Int // net amount the entity is asking to withdraw
  periodStart      String
  periodEnd        String
  status           String   @default("requested") // requested | processing | paid | rejected
  method           String   @default("bank_transfer")
  notes            String?
  requestedAt      DateTime @default(now())
  processedAt      DateTime?
  processedBy      String? // admin user id
  adminNote        String?

  // Manager payouts additionally link their allocated earnings rows.
  managerId        String?
  manager          Manager?             @relation(fields: [managerId], references: [id])
  allocatedEarnings ManagerEarning[]

  @@index([entityType, entityId, status])
}

// ---------------------------------------------------------------------------
// UPLOADED PRESCRIPTIONS (patient-supplied doctor-written Rx)
// A registered patient can snap/upload a copy of a paper prescription they
// received from an offline doctor, then send it to a pharmacy to order meds.
// Used for the public signup → order flow without a Royal Palace encounter.
// ---------------------------------------------------------------------------

model UploadedPrescription {
  id               String   @id
  uploadNumber     String   @unique
  patientId        String
  patientName      String // snapshot for display on the pharmacy side
  prescriberName   String? // optional, the patient can type the doctor's name
  prescriberFacility String?
  notes            String? // patient note to the pharmacy
  // mocked file metadata (name, type, size, dataUrl). dataUrl holds a base64
  // data URL so the prototype can render the uploaded image without storage.
  fileName         String
  fileType         String
  fileSize         Int
  dataUrl          String // data:image/...;base64,....
  status           String   @default("uploaded") // uploaded | under_review | accepted | rejected
  pharmacyId       String? // set when the patient sends it to a specific pharmacy
  createdAt        DateTime @default(now())
  reviewedAt       DateTime?

  patient          Patient  @relation(fields: [patientId], references: [id])
}

// ---------------------------------------------------------------------------
// MANAGER MODULE (plan §4)
// Managers acquire/onboard pharmacies and laboratories, manage a portfolio,
// earn a configurable share of eligible organization payments, and handle
// first-level support. Statuses are stored as strings (SQLite has no native
// enum) and validated in the application layer.
// ---------------------------------------------------------------------------

model Manager {
  id                 String   @id
  userId             String   @unique
  managerNumber      String   @unique
  onboardingCode     String   @unique
  firstName          String
  lastName           String
  email              String
  phone              String
  city               String
  state              String
  territory          String
  employmentStatus   String   @default("full_time") // full_time | contract | probation | suspended | offboarding
  verificationStatus String   @default("pending") // pending | verified | rejected | suspended
  joinedAt           DateTime @default(now())
  profileImage       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  acquiredPharmacies Pharmacy[] @relation("PharmacyAcquiredBy")
  managedPharmacies  Pharmacy[] @relation("PharmacyCurrentManager")
  acquiredLaboratories Laboratory[] @relation("LaboratoryAcquiredBy")
  managedLaboratories  Laboratory[] @relation("LaboratoryCurrentManager")

  assignments  ManagerAssignment[]
  applications ManagerOrganizationApplication[]
  rules        ManagerRevenueShareRule[]
  earnings     ManagerEarning[]
  bankAccount  ManagerBankAccount?
  payouts      PayoutRequest[]
  tickets      SupportTicket[]

  @@index([verificationStatus])
  @@index([state, territory])
}

model ManagerAssignment {
  id                 String    @id
  managerId          String
  organizationType   String // pharmacy | laboratory
  // Exactly one of pharmacyId / laboratoryId must be set — enforced in the
  // assignment policy module (SQLite cannot express XOR FKs).
  pharmacyId         String?
  laboratoryId       String?
  source             String // acquisition | application_approval | admin_assignment | reassignment
  relationshipStatus String    @default("active") // active | paused | ended
  startsAt           DateTime  @default(now())
  endsAt             DateTime?
  assignedBy         String
  reason             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  manager    Manager     @relation(fields: [managerId], references: [id])
  pharmacy   Pharmacy?   @relation(fields: [pharmacyId], references: [id])
  laboratory Laboratory? @relation(fields: [laboratoryId], references: [id])
  earnings   ManagerEarning[]

  @@index([managerId, relationshipStatus])
  @@index([pharmacyId, startsAt])
  @@index([laboratoryId, startsAt])
  @@index([organizationType, relationshipStatus])
}

model ManagerOrganizationApplication {
  id                   String    @id
  applicationNumber    String    @unique
  managerId            String
  organizationType     String // pharmacy | laboratory
  businessName         String
  contactPerson        String
  contactEmail         String
  contactPhone         String
  address              String
  city                 String
  state                String
  registrationNumber   String
  licenceNumber        String?
  notes                String?
  status               String    @default("submitted") // draft | submitted | under_review | information_required | approved | rejected
  submittedAt          DateTime?
  reviewedAt           DateTime?
  reviewerId           String?
  reviewerNote         String?
  createdPharmacyId    String? // application-level reference to the created org
  createdLaboratoryId  String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  manager Manager @relation(fields: [managerId], references: [id])

  @@index([managerId, status])
  @@index([status, submittedAt])
  @@index([organizationType])
}

// Payments made BY a pharmacy/laboratory TO Royal Palace for subscriptions,
// renewals, platform fees and configured service fees. Deliberately separate
// from the patient-centric Payment model (plan §2). Confirmation is
// idempotent on the unique external `reference`.
model OrganizationPayment {
  id               String    @id
  paymentNumber    String    @unique
  organizationType String // pharmacy | laboratory
  pharmacyId       String?
  laboratoryId     String?
  transactionType  String // subscription | renewal | platform_fee | service_fee
  amount           Int // whole naira
  currency         String    @default("NGN")
  method           String    @default("bank_transfer")
  status           String    @default("pending") // pending | successful | failed | cancelled | refunded
  reference        String    @unique // unique external reference/event key
  paidAt           DateTime?
  refundedAt       DateTime?
  refundAmount     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  pharmacy   Pharmacy?        @relation(fields: [pharmacyId], references: [id])
  laboratory Laboratory?      @relation(fields: [laboratoryId], references: [id])
  earnings   ManagerEarning[]

  @@index([organizationType, createdAt])
  @@index([pharmacyId, createdAt])
  @@index([laboratoryId, createdAt])
  @@index([status, paidAt])
  @@index([transactionType])
}

// Effective-dated revenue share rules. Rates are integer basis points
// (10000 = 100%). Overlaps for the same scope are rejected in application code.
model ManagerRevenueShareRule {
  id              String    @id
  managerId       String
  organizationType String // pharmacy | laboratory
  transactionType String // subscription | renewal | platform_fee | service_fee
  rateBps         Int
  effectiveFrom   DateTime  @default(now())
  effectiveUntil  DateTime?
  status          String    @default("active") // active | retired
  createdBy       String
  approvedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  manager Manager @relation(fields: [managerId], references: [id])

  @@index([managerId, organizationType, transactionType, status])
  @@index([effectiveFrom])
  @@index([effectiveUntil])
}

// Immutable earnings ledger. Never mutate or delete historical rows; refunds
// create separate signed reversal entries linked via reversalOfId.
model ManagerEarning {
  id                    String    @id
  earningNumber         String    @unique
  eventKey              String    @unique // idempotency key, e.g. "orgpay:<id>:earning"
  managerId             String
  managerAssignmentId   String? // snapshot of the assignment in force at payment time
  organizationPaymentId String
  organizationType      String
  organizationId        String
  organizationName      String // snapshot — survives org renames
  paymentType           String // snapshot of transactionType
  paymentNumber         String // snapshot
  eligibleAmount        Int // signed: negative on reversal entries
  rateBps               Int // snapshot of the rule in force
  amount                Int // signed: positive earning, negative reversal
  entryType             String // earning | reversal
  status                String    @default("pending") // pending | available | paid | reversed
  occurredAt            DateTime  @default(now())
  availableAt           DateTime? // when the entry became available for payout
  reversalOfId          String?
  payoutRequestId       String? // allocation to the payout that consumed it
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  manager             Manager             @relation(fields: [managerId], references: [id])
  assignment          ManagerAssignment?  @relation(fields: [managerAssignmentId], references: [id])
  organizationPayment OrganizationPayment @relation(fields: [organizationPaymentId], references: [id])
  reversalOf          ManagerEarning?     @relation("EarningReversal", fields: [reversalOfId], references: [id])
  reversals           ManagerEarning[]    @relation("EarningReversal")
  payoutRequest       PayoutRequest?      @relation(fields: [payoutRequestId], references: [id])

  @@index([managerId, status, createdAt])
  @@index([organizationType, organizationId, occurredAt])
  @@index([organizationPaymentId])
  @@index([payoutRequestId])
  @@index([reversalOfId])
}

// One payout account per manager. PROTOTYPE ONLY: the account number is
// stored in plaintext; production must encrypt/tokenize it and hold a
// payout-provider recipient code instead. API responses always return the
// masked form.
model ManagerBankAccount {
  id                 String    @id
  managerId          String    @unique
  bankName           String
  bankCode           String
  accountName        String
  accountNumber      String
  verificationStatus String    @default("pending") // pending | verified | failed
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  manager Manager @relation(fields: [managerId], references: [id])
}

// Support flow: Pharmacy/Laboratory -> Manager (L1) -> Royal Palace (L2) ->
// Finance/Technical/Operations/Compliance. Statuses validated in app code.
model SupportTicket {
  id                   String    @id
  ticketNumber         String    @unique
  organizationType     String
  organizationId       String
  organizationName     String // snapshot
  managerId            String? // assigned manager (L1 owner)
  creatorId            String
  creatorName          String
  subject              String
  category             String
  priority             String    @default("medium") // low | medium | high | urgent
  status               String    @default("new") // new | assigned_to_manager | manager_investigating | waiting_for_organization | escalated_to_royal_palace | royal_palace_investigating | resolved | closed | reopened
  escalationDepartment String?
  escalationReason     String?
  escalatedAt          DateTime?
  resolution           String?
  resolvedAt           DateTime?
  lastActivityAt       DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  manager  Manager?               @relation(fields: [managerId], references: [id])
  messages SupportTicketMessage[]

  @@index([managerId, status, lastActivityAt])
  @@index([organizationType, organizationId, status])
  @@index([status, escalatedAt])
}

model SupportTicketMessage {
  id         String   @id
  ticketId   String
  actorId    String
  actorRole  String
  actorName  String
  body       String
  visibility String   @default("shared") // shared | manager_internal | admin_internal
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId, createdAt])
  @@index([visibility])
}
